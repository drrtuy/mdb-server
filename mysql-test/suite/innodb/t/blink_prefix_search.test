--source include/have_innodb.inc

SET @blink_save=@@global.innodb_blink_enabled;
SET GLOBAL innodb_blink_enabled=ON;
CREATE TABLE t (
  a INT NOT NULL,
  b INT NOT NULL,
  c INT NOT NULL,
  payload VARBINARY(700),
  PRIMARY KEY(a,b),
  KEY k_ac(a,c)
) ENGINE=InnoDB;
--sleep 1
SET @splits_before=(SELECT VARIABLE_VALUE FROM INFORMATION_SCHEMA.GLOBAL_STATUS
                    WHERE VARIABLE_NAME='INNODB_BLINK_LEAF_SPLITS');
INSERT INTO t
WITH RECURSIVE cte(n) AS
(SELECT 1 UNION ALL SELECT n + 1 FROM cte WHERE n < 1000)
SELECT 1,n,n,REPEAT('x',700) FROM cte;
SELECT (SELECT VARIABLE_VALUE FROM INFORMATION_SCHEMA.GLOBAL_STATUS
        WHERE VARIABLE_NAME='INNODB_BLINK_LEAF_SPLITS') > @splits_before
       AS measured_splits;
SELECT COUNT(*),MIN(b),MAX(b) FROM t FORCE INDEX(PRIMARY) WHERE a=1;
SELECT b FROM t FORCE INDEX(PRIMARY) WHERE a=1 ORDER BY b LIMIT 3;
SELECT b FROM t FORCE INDEX(PRIMARY) WHERE a=1 AND b=500;
SELECT COUNT(*),MIN(c),MAX(c) FROM t FORCE INDEX(k_ac) WHERE a=1;
SELECT c FROM t FORCE INDEX(k_ac) WHERE a=1 ORDER BY c LIMIT 3;
CHECK TABLE t;
DROP TABLE t;
SET GLOBAL innodb_blink_enabled=@blink_save;
